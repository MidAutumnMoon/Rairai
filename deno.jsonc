{
    "tasks": {
        "dev": "deno run -A concurrently --names 'web,server' 'deno task dev:web' 'deno task dev:server'",
        "dev:web": "deno run -A vite",
        "dev:server": "deno run --watch -A server/main.ts",
        "build": "NODE_ENV=production deno run -A vite build",
        "preview": "deno run -A vite preview"
    },
    "imports": {
        "@hono/hono": "jsr:@hono/hono@^4.12.32",
        "@std/assert": "jsr:@std/assert@1",
        "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.2.0",
        "concurrently": "npm:concurrently@^10.0.4",
        "svelte": "npm:svelte@^5.56.8",
        "vite": "npm:vite@^8.1.5"
    },
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "checkJs": true,
        "module": "esnext",
        "lib": ["deno.window", "deno.unstable", "node", "dom", "esnext"],
        "types": ["svelte", "vite/client"]
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "jsx.multiLineParens": "never",
        "singleBodyPosition": "sameLine"
    },
    "lint": {
        "rules": {}
    },
    "unstable": ["fmt-component"]
}
