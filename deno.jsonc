{
    "tasks": {
        "dev": "deno run -A concurrently --names 'web,server' 'deno task dev:web' 'deno task dev:server'",
        "dev:web": "deno run -A vite",
        "dev:server": "deno run --watch -A server/main.ts",
        "build": "NODE_ENV=production deno run -A vite build",
        "preview": "deno run -A vite preview"
    },
    "imports": {
        "@earendil-works/pi-agent-core": "npm:@earendil-works/pi-agent-core@^0.82.1",
        "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@^0.82.1",
        "@earendil-works/pi-ai/providers/faux": "npm:@earendil-works/pi-ai@^0.82.1/providers/faux",
        "@earendil-works/pi-ai/providers/openai": "npm:@earendil-works/pi-ai@^0.82.1/providers/openai",
        "@earendil-works/pi-ai/api/openai-completions.lazy": "npm:@earendil-works/pi-ai@^0.82.1/api/openai-completions.lazy",
        "@earendil-works/pi-ai/api/openai-responses.lazy": "npm:@earendil-works/pi-ai@^0.82.1/api/openai-responses.lazy",
        "@earendil-works/pi-ai/api/anthropic-messages.lazy": "npm:@earendil-works/pi-ai@^0.82.1/api/anthropic-messages.lazy",
        "@hono/hono": "jsr:@hono/hono@^4.12.32",
        "@hono/hono/streaming": "jsr:@hono/hono@^4.12.32/streaming",
        "@std/assert": "jsr:@std/assert@1",
        "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.2.0",
        "bits-ui": "npm:bits-ui@^2",
        "concurrently": "npm:concurrently@^10.0.4",
        "dompurify": "npm:dompurify@^3.2.4",
        "marked": "npm:marked@^12.0.2",
        "svelte": "npm:svelte@^5.56.8",
        "vite": "npm:vite@^8.1.5"
    },
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "checkJs": true,
        "module": "esnext",
        "lib": ["deno.window", "deno.unstable", "node", "dom", "esnext"],
        "types": ["svelte", "vite/client"]
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false,
        "jsx.multiLineParens": "never",
        "singleBodyPosition": "sameLine"
    },
    "lint": {
        "rules": {}
    },
    "unstable": ["fmt-component"]
}
