{
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        },
        {
            "files": ["*.jsonc"],
            "options": {
                "parser": "json",
                "trailingComma": "none"
            }
        }
    ]
}
